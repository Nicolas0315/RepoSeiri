{
  "schema_version": "reposeiri.r13-saip.v2",
  "protocol": "R13-SAIP-v2",
  "roadmap": "docs/design/roadmap-v13-semantic-claim-alignment.md",
  "protocol_document": "docs/design/r13-saip-v2-protocol.md",
  "units": [
    { "id": "B0", "name": "baseline_freeze", "depends_on": [] },
    { "id": "B1", "name": "visible_clause_ir", "depends_on": ["B0"] },
    { "id": "B2", "name": "claim_atom_ir", "depends_on": ["B1"] },
    { "id": "B3", "name": "capability_frontend_v2", "depends_on": ["B2"] },
    { "id": "B4", "name": "claim_capability_membrane_v2", "depends_on": ["B3"] },
    { "id": "B5", "name": "ceiling_first_result_unknown", "depends_on": ["B4"] },
    { "id": "B6", "name": "bilingual_semantics", "depends_on": ["B5"] },
    { "id": "B7", "name": "claim_draft_round_trip", "depends_on": ["B6"] },
    { "id": "B8", "name": "contract_hardening", "depends_on": ["B7"] },
    { "id": "B9", "name": "query_plugin_parity", "depends_on": ["B8"] },
    { "id": "B10", "name": "performance_core", "depends_on": ["B9"] },
    { "id": "B11", "name": "readme_product_surface", "depends_on": ["B10"] }
  ],
  "lanes": [
    { "id": "A", "owns": ["ir", "types", "digests"] },
    { "id": "B", "owns": ["parsers", "analyzers"] },
    { "id": "C", "owns": ["schemas", "queries", "launchers"] },
    { "id": "D", "owns": ["fixtures", "tests", "benchmarks"] }
  ],
  "authority_defaults": {
    "analysis": true,
    "mutation": true,
    "verification": true,
    "commit": false,
    "push": false,
    "merge": false,
    "release": false,
    "publication": false,
    "visibility": false,
    "plugin_install": false,
    "restart": false
  },
  "execution": {
    "mode": "sequential_batches_parallel_lanes",
    "max_in_progress_units": 1,
    "max_parallel_lanes": 4,
    "blocking_checks_may_be_skipped": false,
    "preserve_user_changes": true,
    "group_gates_after": ["B3", "B6", "B9", "B11"]
  },
  "semantic_invariants": {
    "core_pipeline": ["ReadmeGrammarIR", "RepositoryCapabilityIR", "ClaimCapabilityMembrane"],
    "claim_alignment_required": true,
    "dimension_only_support_is_sufficient": false,
    "preserve_explicit_unknown": true,
    "supported_requires_aligned_evidence": true,
    "claim_floor_separate_from_ceiling": true,
    "geometry_changes_claim_semantics": false,
    "incremental_must_match_scalar_digest": true,
    "planner_writes_files": false,
    "codex_query_kind_count": 10,
    "codex_schema": "seiri.codex.v2"
  },
  "dependency_cone_stops": {
    "semantic_mismatch": ["B2", "B4", "B5", "B6", "B7", "B11"],
    "unknown_collapse": ["B4", "B5", "B6", "B7", "B11"],
    "evidence_ceiling_regression": ["B4", "B5", "B6", "B7", "B11"],
    "codex_contract_breakage": ["B9", "B11"],
    "digest_nondeterminism": ["B8", "B10", "B11"],
    "scope_escape": ["B8", "B9", "B11"],
    "performance_regression": ["B10"]
  },
  "privacy": {
    "store_source_bodies": false,
    "store_diff_bodies": false,
    "store_private_analysis_identity": false,
    "store_private_analysis_body": false,
    "store_private_calibration_values": false,
    "store_private_digest": false,
    "store_host_absolute_paths": false,
    "store_credentials": false
  },
  "completion": {
    "requires_dependency_order": true,
    "requires_bounded_source_session": true,
    "requires_unknown_regression": true,
    "requires_evidence_ceiling_regression": true,
    "requires_query_compatibility": true,
    "requires_geometry_invariance": true,
    "requires_incremental_equivalence": true,
    "requires_local_verification": true,
    "performance_evidence_is_separate": true,
    "terminal_states": ["ready_for_git", "incomplete"]
  }
}
